# Copy is NOT needed: use the hidden-input scripts, which write .env.local (chmod 600).
#   npm run paypal:key   -> PAYPAL_CLIENT_ID, PAYPAL_CLIENT_SECRET, PAYPAL_ENV=sandbox
#   npm run buyer:key    -> PAYPAL_SANDBOX_BUYER_EMAIL, PAYPAL_SANDBOX_BUYER_PASSWORD (seeding only)
#   npm run claude:key   -> CLAUDE_API_KEY
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_SANDBOX_BUYER_EMAIL=
PAYPAL_SANDBOX_BUYER_PASSWORD=
CLAUDE_API_KEY=
# Optional
DD_DB_PATH=./data/dispute-defender.db
LLM_MAX_CALLS_PER_DAY=40
# Modes (defaults shown)
DD_MODE=replay            # replay = recorded sandbox data, no keys needed; live = real sandbox reads/writes
DD_LLM=fake               # claude = live Claude drafts (needs CLAUDE_API_KEY); cli = dev-only local Claude CLI
DD_PUBLIC_DEMO=0          # 1 on the hosted demo (also blocks the dev-only CLI provider)
PAYPAL_WEBHOOK_ID=        # set after registering the sandbox webhook (developer dashboard, by hand)
DD_MCP_ALLOW_WRITES=0     # 1 lets `npm run mcp` call the sandbox write tools
