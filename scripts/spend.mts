// npm run spend: writes docs/SPEND.md from the local llm_calls log, the single source of truth for
// Claude API spend. Every real call (drafts, insights, recordings) is logged there by LlmBudget.
import { writeFileSync } from "node:fs";
import { openDb } from "../lib/store/db";

const db = openDb();
const rows = db.prepare("SELECT purpose, model, COUNT(*) n, SUM(input_tokens) i, SUM(output_tokens) o, SUM(cost_usd) usd, MIN(created_at) first, MAX(created_at) last FROM llm_calls GROUP BY purpose, model ORDER BY first").all() as { purpose: string; model: string; n: number; i: number; o: number; usd: number; first: string; last: string }[];
const t = db.prepare("SELECT COUNT(*) n, COALESCE(SUM(input_tokens),0) i, COALESCE(SUM(output_tokens),0) o, COALESCE(SUM(cost_usd),0) usd FROM llm_calls").get() as { n: number; i: number; o: number; usd: number };
const md = `# Claude API spend

Single source of truth, generated by \`npm run spend\` from the app's own call log (\`llm_calls\`). Every real Claude call is logged with its tokens and cost (Haiku 4.5: $1 per 1M input tokens, $5 per 1M output tokens).

**Total: ${t.n} calls · ${t.i.toLocaleString("en-US")} input + ${t.o.toLocaleString("en-US")} output tokens · $${t.usd.toFixed(4)}** (as of ${new Date().toISOString().slice(0, 10)})

| Purpose | Model | Calls | Input tokens | Output tokens | Cost |
|---|---|---:|---:|---:|---:|
${rows.map((r) => `| ${r.purpose} | ${r.model} | ${r.n} | ${r.i.toLocaleString("en-US")} | ${r.o.toLocaleString("en-US")} | $${r.usd.toFixed(4)} |`).join("\n")}

Purposes:
- \`draft\`: a live AI draft in the app.
- \`draft:record\` / \`insights:record\`: recording the real AI output that Replay shows at $0 per visitor. Includes re-recordings after prompt or validation changes.

Tests and the public demo make no paid calls: tests use the FakeProvider, and the demo replays recordings. A live "fresh draft" is capped per visitor and per day.
`;
writeFileSync("docs/SPEND.md", md);
console.log(`docs/SPEND.md: ${t.n} calls, $${t.usd.toFixed(4)}`);
